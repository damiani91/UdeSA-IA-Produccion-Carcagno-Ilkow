POSTGRES_USER=mlflow
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mlflow

# Airflow — generar una vez y guardar en .env (nunca commitear .env)
# AIRFLOW_FERNET_KEY:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# AIRFLOW_SECRET_KEY:  python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_FERNET_KEY=reemplazar-con-clave-generada
AIRFLOW_SECRET_KEY=reemplazar-con-clave-generada

# Secret compartido entre la API y el scheduler de Airflow para el endpoint /admin/reload
RELOAD_SECRET=changeme-reload
